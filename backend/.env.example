# ---- Server ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---- Database ----
# In Docker Compose this points at the "mongo" service; locally use mongodb://127.0.0.1:27017/skyrun
MONGO_URI=mongodb://mongo:27017/skyrun

# ---- CORS ----
# Only relevant for a future web client; the mobile app isn't subject to CORS.
CORS_ORIGIN=http://localhost:8081

# ---- JWT ----
# Generate strong random secrets, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=changeme_access_secret_please_generate_a_strong_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_please_generate_a_strong_random_value
JWT_REFRESH_EXPIRES_IN=7d

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Uploads ----
UPLOAD_DIR=uploads/avatars
MAX_AVATAR_SIZE_MB=3

# ---- Routing (route planning feature) ----
# In Docker Compose this points at the "osrm" service; see docker-compose.yml
# for the one-time OSM data-prep steps that service needs before it can serve.
OSRM_URL=http://osrm:5000

# ---- Logging ----
LOG_LEVEL=info
