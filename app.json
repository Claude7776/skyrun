{
  "expo": {
    "name": "SkyRun",
    "slug": "skyrun",
    "scheme": "skyrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0e14",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skyrun.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SkyRun a besoin d'accéder à vos photos pour définir votre avatar.",
        "NSLocationWhenInUseUsageDescription": "SkyRun a besoin de votre position pour afficher votre position sur la carte et enregistrer le trajet de vos footings."
      }
    },
    "android": {
      "package": "com.skyrun.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "SkyRun a besoin d'accéder à vos photos pour définir votre avatar."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkyRun a besoin de votre position pour afficher votre position sur la carte et enregistrer le trajet de vos footings."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0e14"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b8117a79-5c02-40c3-bd0f-94199884de8f"
      }
    },
    "owner": "code777"
  }
}
