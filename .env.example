# ---- Mobile app (Expo) ----
# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time —
# no extra package needed. This must be a URL your phone/simulator can
# actually reach: "localhost" only works from an iOS Simulator on the same
# Mac; a physical device or Android emulator needs your machine's LAN IP
# (e.g. via `ipconfig`/`ifconfig`) or `expo start --tunnel`.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000/api/v1

# ---- Docker Compose / infra ----
# Consumed by docker-compose.yml when running `docker compose up`.
# Feature-specific backend settings (JWT secrets, rate limits, etc.) live in
# backend/.env — copy backend/.env.example there too.
BACKEND_PORT=5000
MONGO_INITDB_ROOT_USERNAME=skyrun
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_DB_NAME=skyrun
CORS_ORIGIN=http://localhost:8081
